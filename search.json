---
layout: null
sitemap: false
---
[
{% for post in site.posts %}
  {% assign search_topic = site.data.topics | where: 'id', post.topic | first %}
  {% assign search_image = site.data.images[post.image].variants | first %}
  {
    "title": {{ post.title | jsonify }},
    "description": {{ post.description | jsonify }},
    "topic": {{ search_topic.title | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "image": {{ search_image.src | default: post.image | relative_url | jsonify }},
    "image_alt": {{ post.image_alt | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
